# Copy to .env (git-ignored). Every value below is a placeholder, not a real secret.
# Use letters and digits in passwords, because they are placed inside a connection URL.

# --- Local MongoDB (started by Docker Compose while this profile is on) ---
COMPOSE_PROFILES=local-db
MONGO_ROOT_USER=llmops
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-password
# Must repeat the user and password above. For MongoDB Atlas, remove COMPOSE_PROFILES
# and paste your Atlas connection string here instead.
MONGODB_URI=mongodb://llmops:change-me-to-a-long-random-password@mongo:27017/?authSource=admin

# --- App behaviour ---
APP_ENV=development
# mock = offline demo with no AI key. Or gemini / openai / anthropic.
LLM_PROVIDER=mock

# --- Optional server-side model keys (users can also type their own in the app) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Protecting your deployment (strongly recommended for anything beyond your own laptop) ---
# Required header value for the management API. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Secret mixed into API-key hashes. Changing it invalidates existing API keys.
API_KEY_PEPPER=

# --- Privacy ---
STORE_PROMPT_TEXT=false
REDACTION_ENABLED=true
TRACE_RETENTION_DAYS=0
